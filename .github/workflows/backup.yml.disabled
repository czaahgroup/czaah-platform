name: Backup database

# PARKED — inert until renamed to backup.yml. See docs/backups.md for the
# one-time setup (enable R2, create a bucket + token, add the secrets).
#
# Weekly logical dump of the production database, gzipped, uploaded to R2
# (S3-compatible). Keeps the last 12 dumps.

on:
  schedule:
    - cron: '17 3 * * 1' # Mondays 03:17 UTC
  workflow_dispatch:

concurrency:
  group: db-backup
  cancel-in-progress: false

jobs:
  dump:
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Install postgresql-client 17
        run: |
          sudo sh -c 'echo "deb https://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" > /etc/apt/sources.list.d/pgdg.list'
          curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | sudo gpg --dearmor -o /etc/apt/trusted.gpg.d/pgdg.gpg
          sudo apt-get update && sudo apt-get install -y postgresql-client-17 awscli

      - name: Dump
        env:
          BACKUP_DB_URL: ${{ secrets.BACKUP_DB_URL }}
        run: |
          set -euo pipefail
          STAMP=$(date -u +%Y-%m-%dT%H%M%SZ)
          FILE="czaah-db-${STAMP}.sql.gz"
          pg_dump "$BACKUP_DB_URL" --no-owner --no-privileges --clean --if-exists \
            | gzip -9 > "$FILE"
          echo "FILE=$FILE" >> "$GITHUB_ENV"
          ls -lh "$FILE"

      - name: Upload to R2
        env:
          AWS_ACCESS_KEY_ID: ${{ secrets.R2_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.R2_SECRET_ACCESS_KEY }}
          R2_ACCOUNT_ID: ${{ secrets.R2_ACCOUNT_ID }}
          R2_BUCKET: ${{ secrets.R2_BUCKET }}
        run: |
          set -euo pipefail
          ENDPOINT="https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com"
          aws s3 cp "$FILE" "s3://${R2_BUCKET}/weekly/${FILE}" --endpoint-url "$ENDPOINT"

          # prune: keep the 12 most recent objects under weekly/
          KEEP=12
          aws s3api list-objects-v2 --bucket "$R2_BUCKET" --prefix "weekly/" \
            --endpoint-url "$ENDPOINT" --query 'sort_by(Contents,&LastModified)[].Key' --output text \
            | tr '\t' '\n' | head -n -"$KEEP" | while read -r KEY; do
              [ -n "$KEY" ] && aws s3 rm "s3://${R2_BUCKET}/${KEY}" --endpoint-url "$ENDPOINT"
            done

      - name: Summary
        run: echo "Backed up **$FILE** to R2 bucket \`$R2_BUCKET/weekly/\`." >> "$GITHUB_STEP_SUMMARY"
